<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>AssemblyInspect</AssemblyName>

    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <TargetFramework>net10.0</TargetFramework>

    <Authors>Robyn</Authors>
    <Description>Assembly inspect suite</Description>
    <LangVersion>latest</LangVersion>

    <Product>$(AssemblyName)</Product>
    <RootNamespace>$(Product)</RootNamespace>
    <TargetName>$(Product)</TargetName>
    <AssemblyName>$(Product)</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
