<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AssemblyInspect.CLI</AssemblyName>

    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <TargetFramework>net10.0</TargetFramework>

    <Authors>Robyn</Authors>
    <Description>Assembly inspect CLI app</Description>
    <LangVersion>latest</LangVersion>

    <Product>$(AssemblyName)</Product>
    <RootNamespace>$(Product)</RootNamespace>
    <TargetName>$(Product)</TargetName>
    <AssemblyName>$(Product)</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AssemblyInspect/AssemblyInspect.csproj" />
  </ItemGroup>

</Project>
